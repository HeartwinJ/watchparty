{
  "name": "watchparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.ts",
    "ui": "vite --host",
    "dev": "NODE_ENV=development node --watch-path server server/server.ts",
    "build": "npm run buildReact && npm run typecheckServer",
    "buildReact": "vite build && npm run typecheck",
    "prettier": "npx prettier --write .",
    "typecheckServer": "tsc --project server/tsconfig.json",
    "typecheck": "tsc --project src/tsconfig.json --noEmit",
    "ncu": "ncu --semverLevel major -u",
    "analyze": "npx source-map-explorer 'build/assets/*.js' --html result.html --no-border-checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run typecheckServer && npm test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@mantine/core": "^8.3.10",
    "@mediabunny/ac3": "^1.61.3",
    "@tabler/icons-react": "^3.35.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/youtube": "^0.1.2",
    "can-autoplay": "^3.0.2",
    "dashjs": "^5.1.0",
    "happy-dom": "^21.0.4",
    "hls.js": "^1.7.3",
    "mediabunny": "^1.61.3",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-linkify": "^1.0.0-alpha",
    "react-router-dom": "^5.3.4",
    "react-secure-link": "^3.2.0",
    "react-transition-group": "^4.4.5",
    "socket.io-client": "^4.8.1",
    "srt-webvtt": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.7",
    "vitest": "^5.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
