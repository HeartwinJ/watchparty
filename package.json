{
  "name": "watchparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.ts",
    "start:prod": "node dist-server/server.js",
    "ui": "vite --host",
    "dev": "NODE_ENV=development node --watch-path server server/server.ts",
    "build": "npm run buildReact && npm run buildServer",
    "buildServer": "tsc --project server/tsconfig.build.json",
    "buildReact": "vite build && npm run typecheck",
    "prettier": "npx prettier --write .",
    "typecheckServer": "tsc --project server/tsconfig.json",
    "typecheck": "tsc --project src/tsconfig.json --noEmit",
    "analyze": "npx source-map-explorer 'build/assets/*.js' --html result.html --no-border-checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run typecheckServer && npm test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@mediabunny/ac3": "^1.66.4",
    "@tabler/icons-react": "^3.53.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/youtube": "^0.3.0",
    "can-autoplay": "^3.0.2",
    "dashjs": "^5.3.0",
    "emoji-mart": "^5.6.0",
    "happy-dom": "^21.0.4",
    "hls.js": "^1.7.4",
    "mediabunny": "^1.66.4",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-transition-group": "^4.4.5",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
