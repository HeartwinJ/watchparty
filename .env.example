# See server/config.ts for list of server config variables
# See src/config.ts for list of client config variables

# Client: where the browser sends API/socket requests. Leave unset for hostname:8080 in dev
# and the same origin in production.
# VITE_SERVER_HOST=https://watch.example.com

# --- Server ---
# Instance password. If blank, auth is disabled (the server logs a warning)
APP_PASSWORD=
# Signs session cookies. If blank, a random one is used and sessions reset on restart.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Where the SQLite database lives (default ./data)
# DATA_DIR=./data
# Optional: Cloudflare Realtime TURN relay for screen/file share (otherwise STUN only)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Optional: enables YouTube search
# YOUTUBE_API_KEY=
# Optional: enables subtitle search/download
# OPENSUBTITLES_KEY=
# Optional: AIOStreams manifest URL, enables title search + debrid streams (/addon/*).
# SECRET: it embeds your AIOStreams config and debrid credentials. Never commit or share it.
# AIOSTREAMS_MANIFEST_URL=https://aio.example.com/stremio/<uuid>/<config>/manifest.json
# Preferred subtitle languages for AIOStreams titles (ISO 639-1, comma-separated)
# SUBTITLE_LANGS=en
