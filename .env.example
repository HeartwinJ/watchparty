# See server/config.ts for list of server config variables
# See src/config.ts for list of client config variables

# Leave blank to allow access to all features without login
VITE_FIREBASE_CONFIG=
# VITE_FIREBASE_CONFIG={"apiKey":"AIzaSyA2fkXeFokJ-Ei_jnzDso5AmjbIaMdzuEc","authDomain":"watchparty-273604.firebaseapp.com","databaseURL":"https://watchparty-273604.firebaseio.com","projectId":"watchparty-273604","storageBucket":"watchparty-273604.appspot.com","messagingSenderId":"769614672795","appId":"1:769614672795:web:54bbda86288ab1a034273e"}

# --- Server ---
# Instance password. If blank, auth is disabled (the server logs a warning)
APP_PASSWORD=
# Signs session cookies. If blank, a random one is used and sessions reset on restart.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Where the SQLite database lives (default ./data)
# DATA_DIR=./data
# Optional: Cloudflare Realtime TURN relay for screen/file share (otherwise STUN only)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Optional: enables YouTube search
# YOUTUBE_API_KEY=
# Optional: enables subtitle search/download
# OPENSUBTITLES_KEY=
