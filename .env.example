# See server/config.ts for list of server config variables
# See src/config.ts for list of client config variables
# Copy to .env (git-ignored, never commit it). `docker compose` reads it too: see DEPLOY.md.

# Client: where the browser sends API/socket requests. Leave unset for hostname:8080 in dev
# and the same origin in production.
# VITE_SERVER_HOST=https://watch.example.com

# --- Server ---
# Instance password. If blank, auth is disabled (the server logs a warning)
APP_PASSWORD=
# Signs session cookies. If blank, a random one is used and sessions reset on restart.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Where the SQLite database lives (default ./data; the Docker image always uses /app/data)
# DATA_DIR=./data
# Optional, strongly recommended for voice calls: Cloudflare Realtime TURN relay for voice calls and screen/file
# share (otherwise STUN only, and calls between some networks can't connect)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Optional: enables YouTube search
# YOUTUBE_API_KEY=
# Optional: adds "Search by file name (OpenSubtitles API)" to the subtitle search (title search needs no key)
# OPENSUBTITLES_KEY=
# User-Agent sent to OpenSubtitles ("<consumer app name> v<version>"); default "watchparty v1"
# OPENSUBTITLES_USER_AGENT=
# Optional: AIOStreams manifest URL, enables Movies & Shows + debrid streams (/addon/streams).
# SECRET: it embeds your AIOStreams config and debrid credentials. Never commit or share it.
# AIOSTREAMS_MANIFEST_URL=https://aio.example.com/stremio/<uuid>/<config>/manifest.json
# Preferred subtitle languages (listed first in auto subtitles and the subtitle search; ISO 639-1, comma-separated)
# SUBTITLE_LANGS=en

# Delete rooms nobody has been in for this many days (0 = keep rooms forever); default 60
# ROOM_MAX_IDLE_DAYS=60

# --- Docker Compose (compose.yaml) ---
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel), used by the
# cloudflared container. Required by compose.yaml, unused by the app itself.
TUNNEL_TOKEN=
